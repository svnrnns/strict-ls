{
  "name": "strict-ls",
  "version": "1.3.1",
  "description": "A TypeScript package for enhanced localStorage handling with a simpler API and strict behavior.",
  "type": "module",
  "main": "dist/types-storage.cjs",
  "module": "dist/types-storage.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/types-storage.js",
    "require": "./dist/types-storage.cjs",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vite-plugin-dts": "^2.3.0"
  },
  "keywords": [
    "localstorage",
    "typescript",
    "strict",
    "api"
  ],
  "author": "seven rings (https://twitter.com/svnrnns)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svnrnns/strict-ls"
  },
  "bugs": {
    "url": "https://github.com/svnrnns/strict-ls/issues"
  },
  "homepage": "https://github.com/svnrnns/strict-ls"
}
